    "rm.cap.met" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedbørradar fra Meteorologisk institutt: 1 km oppløsning, nytt bilde hvert 5. minutt, siste {mins} min, nyeste kl. {h} (radar er noen minutter forsinket). Der kartet er ufarget, ser radaren ingen nedbør – eller området er utenfor radardekning. Neste 90 minutter for stedet: se stripen under."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rain radar by MET Norway: 1 km resolution, a new image every 5 minutes, last {mins} min, latest at {h} (radar runs a few minutes behind). Where the map is uncoloured the radar sees no precipitation, or the area is outside radar coverage. Next 90 minutes for the place: see the strip below."
          }
        }
      }
    },
