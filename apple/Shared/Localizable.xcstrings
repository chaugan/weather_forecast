    "tv.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turvær er en planleggingshjelp, ikke en vurdering av om turen er trygg. Været i fjellet skifter fort: følg <a href=\"https://www.dnt.no/fjellvettreglene/\" target=\"_blank\" rel=\"noopener\">fjellvettreglene</a>, sjekk <a href=\"https://www.varsom.no/\" target=\"_blank\" rel=\"noopener\">varsom.no</a> og snu i tide."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiking weather is a planning aid, not a judgement of whether the hike is safe. Mountain weather changes fast: follow the <a href=\"https://english.dnt.no/the-norwegian-mountain-code/\" target=\"_blank\" rel=\"noopener\">Norwegian mountain code</a>, check <a href=\"https://www.varsom.no/en/\" target=\"_blank\" rel=\"noopener\">varsom.no</a> and turn back in time."
          }
        }
      },
      "comment" : "HTML: render with L10n.attributed(key) or L10n.stripped(key), not as plain text."
    },
    "tv.pace" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo"
          }
        },
        "en" : {
          "stringUnit" : {
