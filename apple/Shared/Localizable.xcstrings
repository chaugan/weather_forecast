      }
    },
    "tv.ch.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperaturen er lufttemperatur i turhøyden; «føles som» tar vinden med. Sikt, tordenpotensial og frysenivå er fra DMIs modell for Norden. Fem modeller er ingen garanti: været i fjellet skifter fortere enn varselet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The temperature is the air temperature at the trail's height; \"feels like\" includes the wind. Visibility, thunder potential and freezing level come from DMI's Nordic model. Five models are no guarantee: mountain weather changes faster than the forecast."
          }
        }
      }
    },
    "tv.ch.steep" : {
