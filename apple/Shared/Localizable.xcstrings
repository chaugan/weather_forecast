    "kv.cold.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fartsvinden: hvor kaldt lufta kjennes i farten du kjører, med vindavkjølingsformelen (Environment Canada og USAs værtjeneste) og farten på hver strekning. Værets egen vind er ikke regnet med. Formelen gjelder bare når lufta er 10° eller kaldere, så over det sies ingenting. Teller for MC: litt under 5°, mer under 0°, og ekstra i regn når lufta er under 8°."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riding wind: how cold the air feels at the speed you ride, by the wind chill formula (Environment Canada and the US National Weather Service) and the speed on each stretch. The weather's own wind is not added. The formula only holds with the air at 10° or colder, so above that nothing is said. Counts for motorcycles: a little below 5°, more below 0°, and extra in rain with the air below 8°."
          }
        }
      }
    },
