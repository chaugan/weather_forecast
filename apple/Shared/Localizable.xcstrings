    "ex.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver tynn grå linje er én modell, den blå linjen er Glett sitt vektede snitt. Ligger linjene tett, er varselet sikkert; sprer de seg, er det usikkert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each thin grey line is one model, the blue line is Glett's weighted average. Tight lines mean a confident forecast; spread lines mean uncertainty."
          }
        }
      }
    },
