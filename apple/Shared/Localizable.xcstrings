    "kv.ch.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperaturen er lufttemperatur. Veibanen kan være kaldere, særlig på bruer og klare netter, så «mulig glatt» er en risiko, ikke et faktum. Der Statens vegvesen har veibaneprognose (omtrent 400 punkter, et døgn frem), brukes den i stedet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The temperature is the air temperature. The road can be colder, especially on bridges and on clear nights, so \"possibly slippery\" is a risk, not a fact. Where the road authority has a road-surface forecast (about 400 points, a day ahead), that is used instead."
          }
        }
      }
    },
