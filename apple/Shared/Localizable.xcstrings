        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " De første seks timene teller MET Nordic og Yr ekstra (opptil dobbelt), fordi de oppdateres oftere med målinger. Dette er en prøveordning."
          }
        },
        "en" : {
          "stringUnit" : {
