    "kv.grip.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under 5° griper dekk og asfalt dårligere, og dekkene blir ikke varme. Det merkes mest i svinger: ta dem rolig. Gjelder lufttemperaturen langs ruta (ikke hvor kaldt du har det). Teller for MC, mest på svingete strekninger."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Below 5° tyres and asphalt grip less, and the tyres do not warm up. It shows most in bends: take them gently. This is the air temperature along the route (not how cold you feel). Counts for motorcycles, most on bendy stretches."
          }
        }
      }
    },
    "kv.grip.help.road" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under 5° griper dekk og asfalt dårligere, og dekkene blir ikke varme. Det merkes mest i svinger: ta dem rolig. Gjelder lufttemperaturen langs ruta, og vegtemperaturen der en vegmyndighet måler eller varsler den. Teller for MC, mest på svingete strekninger."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Below 5° tyres and asphalt grip less, and the tyres do not warm up. It shows most in bends: take them gently. This is the air temperature along the route, and the road temperature where a road authority measures or forecasts it. Counts for motorcycles, most on bendy stretches."
          }
        }
      }
    },
    "kv.gusts" : {
