    "kv.dep.ensfail" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fikk ikke sammenlignet med de andre værmodellene nå. Mer enn drøyt to døgn fram mangler vindkastene, så avreiser da kan se roligere ut enn de er."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not compare with the other weather models right now. More than about two days ahead the gusts are missing, so departures then may look calmer than they are."
          }
        }
      }
    },
