    "sm.info" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mørk flate er skygge fra terrenget – fjell og åser, også langt unna. Skyggen tegnes straks i nettleseren og erstattes av Sundrifts nøyaktige beregning (2 m terreng, fjell inntil 40 km unna) etter hvert som den lastes. Trær og bygninger er ikke med. Figuren står der soltidene gjelder. Høyreklikk eller hold fingeren på kartet for å flytte den og få soltidene der. Skyer er ikke med: kartet viser hvor sola når fram når himmelen er klar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dark area is shadow from the terrain – mountains and hills, including far ones. It is drawn at once in the browser and replaced by Sundrift's accurate computation (2 m terrain, mountains up to 40 km away) as that loads. Trees and buildings are not included. The figure stands where the sun times apply. Right-click or press and hold on the map to move it and get the sun times there. Clouds are not included: the map shows where the sun reaches under a clear sky."
          }
        }
      }
    },
