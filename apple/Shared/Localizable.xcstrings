    "lm.obs.cap" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallene i kartet er middelet i hver rute à 1 km ({c} ruter, {n} private værstasjoner, Netatmo). {a}° i linjen over er snittet av alle stasjonene rundt stedet. Fargen er glattet mellom rutene og tegnet bare inntil ca. 2 km fra en stasjon. Varselet for stedet nå (modellenes vektede snitt) er {m}°. Trykk i kartet for tallene bak en rute."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The numbers are the mean of each 1 km cell ({c} cells, {n} private weather stations, Netatmo). {a}° in the line above is the average of all stations around the place. The colour is smoothed between cells and drawn only within about 2 km of a station. The forecast for the place now (the models' weighted average) is {m}°. Tap the map for the numbers behind a cell."
          }
        }
      }
    },
