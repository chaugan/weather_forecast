      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på en søyle for å velge avreise. Feltet etter siste start er timene fram til siste ankomst; den blå rammen er turen du har valgt. Beste start kan være alle fire dagene, så lenge varselet rekker hele turen. Høy søyle = bedre kjørevær (beste rute for hver avreise); blekere søyler er lenger frem og mer usikre. ★ = beste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a bar to pick a departure. The field after the last start is the hours up to the latest arrival; the blue frame is the trip you chose. The best start can be on any of the four days, as long as the forecast covers the whole trip. Taller bar = better driving weather (best route for each departure); paler bars are further ahead and less certain. ★ = best."
          }
        }
      }
    },
    "kv.dep.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høy søyle = bedre kjørevær (beste rute for hver avreise). Blekere søyler er lenger frem og mer usikre. Best: <b>{d}</b>"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taller bar = better driving weather (best route for each departure). Paler bars are further ahead and less certain. Best: <b>{d}</b>"
          }
        }
      },
      "comment" : "HTML: render with L10n.attributed(key) or L10n.stripped(key), not as plain text."
    },
