        }
      }
    },
    "np.mode.note.d" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dag: rasteplasser og lommer er med, hus teller ikke i rekkefølgen, og bord, badeplass, utsikt og toalett trekker opp. Stedene er de samme som for natten, så ingen ligger nærmere enn 150 m fra en bygning (80 m i Sverige og Finland)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Day: rest areas and lay-bys are included, houses do not count in the order, and tables, bathing places, views and toilets move a spot up. The spots are the same as for the night, so none is closer than 150 m to a building (80 m in Sweden and Finland)."
          }
        }
      }
    },
    "np.mode.note.n" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natt: ingen steder ligger nærmere enn 150 m fra en bygning (80 m i Sverige og Finland), rasteplasser og lommer er bare med om du krysser av for dem, og forslagene rangeres etter ro og avstand til hus og hovedvei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Night: no spot is closer than 150 m to a building (80 m in Sweden and Finland), rest areas and lay-bys are only included if you tick them, and the suggestions are ranked by quiet and distance to houses and main roads."
          }
        }
      }
    },
