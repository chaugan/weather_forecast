    "kv.ens.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen av værmodellene gir verre vær her enn det som vises. Glett spør fem modeller (MET Nordic, ECMWF, DWD ICON, NOAA GFS, UK Met Office). De neste 48 timene viser Glett MET Nordic; lenger frem bestemmer det vektede flertallet. «Kanskje» betyr minst en tredjedel av stemmene, «liten sjanse» færre. Modellene er ikke uavhengige, så dette er ingen sannsynlighet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some of the weather models give worse weather here than shown. Glett asks five models (MET Nordic, ECMWF, DWD ICON, NOAA GFS, UK Met Office). For the next 48 hours Glett shows MET Nordic; further ahead the weighted majority decides. \"Maybe\" means at least a third of the votes, \"little chance\" fewer. The models are not independent, so this is no probability."
          }
        }
      }
    },
    "kv.ens.maybe" : {
