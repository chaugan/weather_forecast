    "tv.wax.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et forslag ut fra fargeskalaen produsentene deler, ikke en garanti. Merkene avviker 1–3 grader: prøv de første hundre meterne og juster. Merkenavn er bare eksempler; Glett har ingen tilknytning til produsentene."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A suggestion from the colour scale the makers share, not a guarantee. Brands differ by 1–3 degrees: try the first few hundred metres and adjust. Brand names are only examples; Glett has no ties to the makers."
          }
        }
      }
    },
