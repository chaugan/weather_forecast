    "np.law.all" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg skilt og lokale forbud, ikke stopp opp trafikken, og ta med deg alt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follow signs and local bans, do not block the road, and take everything with you."
          }
        }
      }
    },
    "np.law.day" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pause på dagen: stå på rasteplass, lovlig parkering eller veiskulder der det er lov å stoppe, og ikke sperr vei, avkjørsel eller snuplass."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A break by day: park at a rest area, legal parking or on the shoulder where stopping is allowed, and do not block a road, a driveway or a turning place."
          }
        }
      }
    },
    "np.law.fi" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Finland gir allemannsretten ingen rett til å kjøre ut i terrenget: parker der det er lov. Telt for en kort tid, ikke for nær bebyggelse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Finland everyman's right gives no right to drive into the terrain: park where it is allowed. Tent for a short time, not too close to homes."
          }
        }
      }
    },
    "np.law.no" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overnatting i bil eller bobil følger allemannsretten: minst 150 m fra bebodd hus eller hytte og høyst to døgn på samme sted. Bilen skal stå på veiskulderen eller lovlig parkering – camping med bil ute i terrenget er ikke lov. Telt: de samme 150 m, ikke på dyrket mark."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleeping in a car or motorhome follows the right to roam: at least 150 m from an inhabited house or cabin and at most two nights in one place. The car stays on the road shoulder or legal parking – camping with a vehicle out in the terrain is not allowed. Tent: the same 150 m, not on farmland."
          }
        }
      }
    },
    "np.law.se" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Sverige gir allemannsretten ingen rett til å stå med bil eller bobil i naturen: parker der det er lov. Telt: et døgn, ikke nær bolighus, ikke på dyrket mark."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Sweden the right of public access gives no right to stay with a car or motorhome in nature: park where it is allowed. Tent: one night, not close to houses, not on farmland."
          }
        }
      }
    },
    "np.lead" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fine steder å stoppe med bil eller bobil – for natten eller en pause på dagen: ved vann, borte fra husene og hovedveien, med plass til å stå."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good places to stop by car or motorhome – for the night or a break by day: by water, away from houses and main roads, with room to park."
          }
        }
      }
    },
