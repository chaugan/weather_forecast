            "state" : "translated",
            "value" : "Fast"
          }
        }
      }
    },
    "tv.pace.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal er DNTs regel: 3,5 km/t pluss 15 min per 100 høydemeter, med pauser; på skogsvei 5,5 km/t og 10 min per 100 høydemeter, nedover koster ingenting; bratte partier (over 25 %) regnes 10–25 % saktere. Rolig gir 25 % mer tid, rask 20 % mindre."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal is DNT's rule: 3.5 km/h plus 15 min per 100 m of climb, breaks included; 5.5 km/h and 10 min per 100 m of climb on forest roads, descents cost nothing; steep stretches (over 25 %) count 10–25 % slower. Easy adds 25 %, fast takes 20 % off."
          }
        }
      }
    },
    "tv.pace.help.w" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal på ski: 4 km/t pluss 10 min per 100 høydemeter, med pauser (en tommelfingerregel for skitur). Rolig gir 25 % mer tid, rask 20 % mindre."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal on skis: 4 km/h plus 10 min per 100 m of climb, breaks included (a rule of thumb for ski touring). Easy adds 25 %, fast takes 20 % off."
          }
        }
      }
    },
    "tv.pace.normal" : {
