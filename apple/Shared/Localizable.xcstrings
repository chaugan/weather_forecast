    "lg.storm" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tordensignal: værkode 95–99 (fullt signal) eller CAPE ≥ 1000 J/kg (halvt signal). Sjansen er gjennomsnittet av signalene fra alle modellene. CAPE er et mål på energien som er tilgjengelig for ustabilitet i atmosfæren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storm signal: weather code 95–99 (full signal) or CAPE ≥ 1000 J/kg (half signal). The chance is the average signal across all models. CAPE measures the energy available for atmospheric instability."
          }
        }
      }
    },
    "lg.temperature_2m" : {
