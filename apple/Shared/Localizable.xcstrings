    "tv.ch.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk eller dra i diagrammet for å se været på et punkt; trykk for å vise stedet på kartet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap or drag in the chart to see the weather at a point; tap to show the spot on the map."
          }
