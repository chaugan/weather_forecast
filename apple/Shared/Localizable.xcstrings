    "tv.dep.far" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over {n} dager fram: MET Nordic-varselet (1 km) rekker ikke så langt, så dette bygger bare på de globale modellene (10–25 km) og er mer usikkert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More than {n} days ahead: the MET Nordic forecast (1 km) does not reach that far, so this rests on the global models (10–25 km) alone and is less certain."
          }
        }
      }
    },
    "tv.dep.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på en søyle for å velge start. Feltet etter siste start er timene fram til siste ankomst; den blå rammen er turen du har valgt. Den gule streken (2,5 d) er der MET Nordic-varselet slutter; stripene bak den har bare de globale modellene, og beste start velges blant turene som er framme før streken. Fargen er dommen for den starten (grønn: fint, lysegrønn: litt regn, gul: vind, tåke eller mørke, rød: torden, kulde eller skredfare); høyere søyle = bedre enn de andre startene."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a bar to pick a start. The field after the last start is the hours up to the latest arrival; the blue frame is the trip you chose. The amber line (2.5 d) is where the MET Nordic forecast ends; the stripes beyond it have the global models only, and the best start is chosen among trips that arrive before the line. The colour is the verdict for that start (green: fine, light green: some rain, amber: wind, fog or dark, red: thunder, cold or avalanche risk); a taller bar is better than the other starts."
          }
        }
      }
    },
    "tv.dep.isbest" : {
      "extractionState" : "manual",
      "localizations" : {
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den valgte starten er den beste"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chosen start is the best"
          }
        }
      }
    },
