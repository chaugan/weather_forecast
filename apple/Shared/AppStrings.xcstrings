    "app.privacy.apple" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is used only when you tap “My location”. Apple looks up the place name."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posisjonen din brukes bare når du trykker «Min posisjon». Apple finner stedsnavnet."
          }
        }
      }
    },
    "app.privacy.glett" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "glett.no receives the coordinates for nearby measurements and verification, and the app's version number – never a device ID."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "glett.no får koordinatene for målinger i nærheten og etterprøving, og appens versjonsnummer – aldri en enhets-ID."
          }
        }
      }
    },
    "app.privacy.lead" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glett has no account, no ads and no tracking. Your places and settings stay on the device, and nothing about you is stored on a server."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glett har ingen konto, ingen reklame og ingen sporing. Stedene og innstillingene dine blir på enheten, og ingenting om deg lagres på en server."
          }
        }
      }
    },
    "app.privacy.met" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MET Norway receives the place's coordinates, for the Yr forecast and the radar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meteorologisk institutt får koordinatene til stedet, for Yr-varselet og radaren."
          }
        }
      }
    },
    "app.privacy.more" : {
      "extractionState" : "manual",
