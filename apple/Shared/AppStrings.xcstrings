    "app.rel.weights.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The model's vote is multiplied by its weight while “Weight by reliability” is on. 1 is a plain average; without a weight the model counts 1."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modellens stemme ganges med vekten når «Vekt etter pålitelighet» er på. 1 er et vanlig snitt; uten vekt teller modellen 1."
          }
        }
      }
    },
